# ─────────────────────────────────────────────────────────────────────────────
#  Configuración del agente. Copia este archivo a .env y completa la clave.
#  NUNCA commitees .env (ya está en .gitignore). La clave del modelo vive SOLO
#  aquí / en las variables de entorno del host. Nunca en el front ni en logs.
# ─────────────────────────────────────────────────────────────────────────────

# ── Opción recomendada (gratis, cuota generosa): Google Gemini ───────────────
#  Consigue una key gratis en https://aistudio.google.com  →  "Get API key"
GEMINI_API_KEY=
MODEL=gemini-2.5-flash

# ── Alternativa: proveedor OpenAI-compatible (Groq / Mistral / OpenAI / local) ─
#  Groq (gratis):     https://console.groq.com/keys   base_url ↓
#  Mistral (gratis):  https://console.mistral.ai      base_url = https://api.mistral.ai/v1
#  Descomenta y rellena para usar esta vía en lugar de Gemini:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# MODEL=llama-3.3-70b-versatile

# ── Operación del agente (opcional, con defaults) ────────────────────────────
PORT=3000
MAX_ITERATIONS=25
MAX_TOKENS_PER_SESSION=60000
