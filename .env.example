# ─────────────────────────────────────────────────────────────────────────────
#  Copia este archivo a .env y completa la clave. NUNCA subas .env al repo
#  (está en .gitignore). La clave vive solo aquí o en las variables del host.
# ─────────────────────────────────────────────────────────────────────────────

# Google Gemini (gratis): https://aistudio.google.com  ->  "Get API key"
GEMINI_API_KEY=
MODEL=gemini-3.5-flash
# Modelos de respaldo, en orden, si el principal está saturado (429/503) o no responde.
MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Operación del agente (opcional; estos son los valores por defecto)
PORT=3000
MAX_ITERATIONS=25
MAX_TOKENS_PER_SESSION=400000
LLM_TIMEOUT_MS=45000
